rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRecipeOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsOwnPublicRecipe() {
      return isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility == "public"
        && request.resource.data.likeCount == 0
        && xbloomFieldsOk(request.resource.data);
    }

    // Official share page only. The id is often percent-encoded base64 (%2F, %3D);
    // the stored string must match that form, so this does not decode it.
    function isOfficialXBloomShareURL(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 800
        && value.matches('^https://share-h5\\.xbloom\\.com/\\?((?:[^=&#]+=[^&#]*&)*)id=[^&#\\s]+((?:&[^=&#]+=[^&#]*)*)$');
    }

    function xbloomFieldOk(data, key) {
      return !(key in data) || isOfficialXBloomShareURL(data[key]);
    }

    function xbloomFieldsOk(data) {
      return xbloomFieldOk(data, 'xbloomURL')
        && xbloomFieldOk(data, 'xbloomStudioURL')
        && xbloomFieldOk(data, 'xbloomOriginalURL');
    }

    function onlyChangesLikeCount() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likeCount"])
        && request.resource.data.likeCount >= 0
        && (
          request.resource.data.likeCount == resource.data.likeCount + 1
          || request.resource.data.likeCount == resource.data.likeCount - 1
        );
    }

    function ownerUpdatesOwnRecipe() {
      return isRecipeOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.visibility == resource.data.visibility
        && xbloomFieldsOk(request.resource.data);
    }

    function createsOwnLike(uid) {
      return isOwner(uid)
        && request.resource.data.uid == request.auth.uid;
    }

    function createsReport(reportId) {
      return isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && reportId == request.auth.uid + '_' + request.resource.data.recipeId;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if isOwner(uid);

      match /recipes/{recipeId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow create: if createsOwnPublicRecipe();
      allow update: if onlyChangesLikeCount() || ownerUpdatesOwnRecipe();
      allow delete: if isRecipeOwner();

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create: if createsOwnLike(uid);
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /reports/{reportId} {
      // Allow checking your own report doc before it exists (reportId = uid_recipeId)
      allow get: if isSignedIn() && reportId.matches('^' + request.auth.uid + '_.*');
      allow create: if createsReport(reportId)
        && !exists(/databases/$(database)/documents/reports/$(reportId));
      allow update, delete, list: if false;
    }
  }
}
